"use client";

import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { toast } from "react-hot-toast";
import { CheckCircle2, Clock, LogOut, RefreshCcw, Search, UserCheck, XCircle } from "lucide-react";
import axios from "axios";

const statusClass = {
  approved: "bg-emerald-100 text-emerald-700",
  pending: "bg-amber-100 text-amber-700",
  revision: "bg-rose-100 text-rose-700",
  rejected: "bg-rose-100 text-rose-700",
};

export default function TeacherDashboard() {
  const [user, setUser] = useState(null);
  const [projects, setProjects] = useState([]);
  const [query, setQuery] = useState("");
  const [active, setActive] = useState(null);
  const [comment, setComment] = useState("");
  const router = useRouter();

  const load = () => {
    const run = async () => {
      try {
        const [{ data: me }, { data }] = await Promise.all([axios.get("/api/me"), axios.get("/api/teacher/projects")]);
        if (!me.user || me.user.role !== "teacher") return router.push("/auth/login");
        const teacherProjects = data.projects;
        setUser(me.user);
        setProjects(teacherProjects);
        setActive((prev) => teacherProjects.find((project) => project.id === prev?.id) || teacherProjects[0] || null);
      } catch {
        router.push("/auth/login");
      }
    };
    run();
  };

  useEffect(() => {
    load();
  }, [router]);

  const filtered = useMemo(() => projects.filter((project) => `${project.title} ${project.studentName} ${project.domain}`.toLowerCase().includes(query.toLowerCase())), [projects, query]);
  const pendingCount = projects.filter((project) => project.status === "pending").length;
  const avgProgress = projects.length ? Math.round(projects.reduce((sum, project) => sum + project.progress, 0) / projects.length) : 0;

  const decide = async (status) => {
    if (!active) return;
    try {
      await axios.patch("/api/teacher/projects", {
        projectId: active.id,
        status,
        comment: comment || (status === "approved" ? "Approved for continued development." : "Please revise according to supervisor feedback."),
      });
      toast.success(status === "approved" ? "Project approved." : "Revision requested.");
      setComment("");
      load();
    } catch (error) {
      toast.error(error.response?.data?.message || "Unable to review project.");
    }
  };

  const signOut = async () => {
    await axios.post("/api/auth/logout");
    router.push("/auth/login");
  };

  if (!user) return null;

  return (
    <main className="min-h-screen bg-slate-50">
      <header className="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
        <div className="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
          <div>
            <p className="text-xs font-bold uppercase tracking-[0.2em] text-[#F34F1F]">Teacher dashboard</p>
            <h1 className="text-xl font-bold text-slate-900">{user.name}</h1>
          </div>
          <div className="flex gap-3">
            <button onClick={() => load()} className="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100"><RefreshCcw size={16} className="mr-2 inline" /> Refresh</button>
            <button onClick={signOut} className="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"><LogOut size={16} className="mr-2 inline" /> Sign out</button>
          </div>
        </div>
      </header>

      <section className="mx-auto max-w-7xl px-6 py-8">
        <div className="mb-6 grid gap-4 md:grid-cols-3">
          <Metric icon={UserCheck} label="Supervised teams" value={projects.length} />
          <Metric icon={Clock} label="Pending reviews" value={pendingCount} />
          <Metric icon={CheckCircle2} label="Average progress" value={`${avgProgress}%`} />
        </div>

        <div className="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <section className="rounded-[2rem] bg-white p-6 shadow-sm">
            <div className="mb-5 flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
              <Search size={18} className="text-slate-400" />
              <input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Search projects or students" className="w-full bg-transparent text-sm outline-none" />
            </div>
            <div className="space-y-3">
              {filtered.map((project) => (
                <button key={project.id} onClick={() => setActive(project)} className={`w-full rounded-2xl border p-4 text-left transition ${active?.id === project.id ? "border-[#F34F1F] bg-orange-50" : "border-slate-100 bg-slate-50 hover:bg-slate-100"}`}>
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <p className="font-bold text-slate-900">{project.title}</p>
                      <p className="mt-1 text-sm text-slate-500">{project.studentName} • Group {project.group}</p>
                    </div>
                    <span className={`rounded-full px-2.5 py-1 text-xs font-bold uppercase ${statusClass[project.status]}`}>{project.status}</span>
                  </div>
                  <div className="mt-4 h-2 rounded-full bg-white"><div className="h-2 rounded-full bg-[#F34F1F]" style={{ width: `${project.progress}%` }} /></div>
                </button>
              ))}
            </div>
          </section>

          <section className="rounded-[2rem] bg-white p-8 shadow-sm">
            {active ? (
              <>
                <span className={`rounded-full px-3 py-1 text-xs font-bold uppercase ${statusClass[active.status]}`}>{active.status}</span>
                <h2 className="mt-4 text-3xl font-bold text-slate-900">{active.title}</h2>
                <p className="mt-2 text-slate-500">{active.studentName} • {active.domain} • Submitted {active.submittedAt}</p>
                <div className="mt-8 grid gap-5 md:grid-cols-2">
                  <Block title="Abstract" text={active.abstract} />
                  <Block title="Problem statement" text={active.problemStatement} />
                  <Block title="Proposed solution" text={active.proposedSolution} />
                  <Block title="Tech stack" text={active.techStack.join(", ")} />
                </div>
                <div className="mt-8 rounded-2xl bg-slate-50 p-5">
                  <label className="mb-2 block text-sm font-bold text-slate-700">Supervisor feedback</label>
                  <textarea value={comment} onChange={(event) => setComment(event.target.value)} rows={4} placeholder="Write feedback for the student..." className="w-full resize-none rounded-2xl border border-slate-200 bg-white p-4 text-sm outline-none focus:border-[#F34F1F]" />
                  <div className="mt-4 flex flex-wrap gap-3">
                    <button onClick={() => decide("approved")} className="inline-flex items-center gap-2 rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white"><CheckCircle2 size={16} /> Approve</button>
                    <button onClick={() => decide("revision")} className="inline-flex items-center gap-2 rounded-2xl bg-rose-600 px-5 py-3 text-sm font-bold text-white"><XCircle size={16} /> Request revision</button>
                  </div>
                </div>
              </>
            ) : (
              <p className="text-slate-500">No supervised projects yet.</p>
            )}
          </section>
        </div>
      </section>
    </main>
  );
}

function Metric({ icon: Icon, label, value }) {
  return <div className="rounded-[2rem] bg-white p-6 shadow-sm"><Icon className="text-[#F34F1F]" /><p className="mt-4 text-sm font-semibold text-slate-500">{label}</p><p className="mt-1 text-3xl font-bold text-slate-900">{value}</p></div>;
}

function Block({ title, text }) {
  return <div><h3 className="font-bold text-slate-900">{title}</h3><p className="mt-2 text-sm leading-6 text-slate-500">{text}</p></div>;
}
